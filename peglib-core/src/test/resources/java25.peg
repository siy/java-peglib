# Java 25 PEG Grammar
#
# Canonical grammar for the Java 25 parser example. Loaded as a classpath resource
# by Java25GrammarExample and Java25ParserTest.
#
# Cut operator (^) commits to current alternative, preventing backtracking.
# Used after discriminating keywords to improve error messages and performance.

# === Compilation Units (JLS 7.3-7.8) ===
CompilationUnit <- ModuleDecl / OrdinaryUnit
# JEP 512 (Compact Source Files and Instance Main Methods) — final in Java 25.
# A compact source file has top-level methods/fields with no enclosing class; the
# compiler wraps them in an implicitly declared class.
#
# TypeDecl MUST stay the first alternative. It and TopLevelMember share the
# 'Annotation* Modifier*' prefix, so reversing them would let TopLevelMember
# win on ordinary files and change their CST shape — which the corpus gates and
# the CST-shape assertion would both flag.
OrdinaryUnit <- PackageDecl? ImportDecl* (TypeDecl / TopLevelMember / ';')*
TopLevelMember <- Annotation* Modifier* (MethodDecl / FieldDecl)
PackageDecl <- Annotation* 'package' ^ QualifiedName ';'
ImportDecl  <- 'import' ^ ('module' QualifiedName ';' / 'static'? QualifiedName ('.' '*')? ';')

# === Module Declarations (JLS 7.7) ===
ModuleDecl <- Annotation* 'open'? 'module' ^ QualifiedName '{' ModuleDirective* '}'
ModuleDirective <- RequiresDirective / ExportsDirective / OpensDirective / UsesDirective / ProvidesDirective
RequiresDirective <- 'requires' ^ ('transitive' / 'static')* QualifiedName ';'
ExportsDirective <- 'exports' ^ QualifiedName ('to' QualifiedName (',' QualifiedName)*)? ';'
OpensDirective <- 'opens' ^ QualifiedName ('to' QualifiedName (',' QualifiedName)*)? ';'
UsesDirective <- 'uses' ^ QualifiedName ';'
ProvidesDirective <- 'provides' ^ QualifiedName 'with' QualifiedName (',' QualifiedName)* ';'

TypeDecl <- Annotation* (Modifier / ValueKW &(Modifier* (ClassKW / RecordKW)))* TypeKind
TypeKind <- ClassDecl / InterfaceDecl / EnumDecl / RecordDecl / AnnotationDecl
ClassDecl <- ClassKW ^ Identifier TypeParams? ('extends' Type)? ImplementsClause? PermitsClause? ClassBody
InterfaceDecl <- InterfaceKW ^ Identifier TypeParams? ('extends' TypeList)? PermitsClause? ClassBody
AnnotationDecl <- '@' InterfaceKW ^ Identifier TypeParams? ('extends' TypeList)? AnnotationBody
# Type declaration keywords with word boundary (prevents 'class' matching prefix of 'className')
ClassKW <- < 'class' ![a-zA-Z0-9_$] >
InterfaceKW <- < 'interface' ![a-zA-Z0-9_$] >
AnnotationBody <- '{' AnnotationMember* '}'
AnnotationMember <- Annotation* (Modifier / ValueKW &(Modifier* (ClassKW / RecordKW)))* (AnnotationElemDecl / FieldDecl / TypeKind) / ';'
AnnotationElemDecl <- TypeParams? Type Identifier '(' Params? ')' Dims? Throws? ('default' AnnotationElem)? (Block / ';')
EnumDecl <- EnumKW ^ Identifier ImplementsClause? EnumBody
# Lookahead ensures this is a record declaration (record Name(...)) not:
# - method call: record(...)
# - field/variable of type 'record': record field;
RecordDecl <- RecordKW &(Identifier TypeParams? '(') Identifier ^ TypeParams? '(' RecordComponents? ')' ImplementsClause? RecordBody
EnumKW <- < 'enum' ![a-zA-Z0-9_$] >
RecordKW <- < 'record' ![a-zA-Z0-9_$] >
ImplementsClause <- 'implements' ^ TypeList
PermitsClause <- 'permits' ^ TypeList
TypeList <- Type (',' Type)*
TypeParams <- '<' TypeParam (',' TypeParam)* '>'
TypeParam <- Annotation* Identifier ('extends' Type ('&' Type)*)?

ClassBody <- '{' ClassMember* '}'
ClassMember <- Annotation* (Modifier / ValueKW &(Modifier* (ClassKW / RecordKW)))* Member / InitializerBlock / ';'
Member <- ConstructorDecl / TypeKind / MethodDecl / FieldDecl
InitializerBlock <- 'static'? Block
EnumBody <- '{' EnumConsts? (';' ClassMember*)? '}'
EnumConsts <- EnumConst (',' EnumConst)* ','? / ','
EnumConst <- Annotation* Identifier ('(' Args? ')')? ClassBody?
RecordComponents <- RecordComp (',' RecordComp)*
RecordComp <- Annotation* Type (Annotation* '...')? Identifier
RecordBody <- '{' RecordMember* '}'
RecordMember <- CompactConstructor / ClassMember
CompactConstructor <- Annotation* Modifier* Identifier Block

FieldDecl <- Type VarDecls ';'
VarDecls <- VarDecl (',' VarDecl)*
VarDecl <- Identifier Dims? ('=' VarInit)?
VarInit <- '{' (VarInit (',' VarInit)*)? ','? '}' / Expr
MethodDecl <- Annotation* TypeParams? Type Identifier '(' ^ Params? ')' Dims? Throws? (Block / ';')
Params <- Param (',' Param)*
# A receiver parameter (JLS 8.4.1) names 'this' instead of a variable; it exists so
# 'this' can carry type annotations. Ordered first: for an ordinary parameter the
# Type matches and the 'this' check fails, so it backtracks to the normal form.
# Still over-permissive on position — the JLS allows a receiver parameter only in
# first place, which is a validation concern, not a parsing one.
#
# An inner class constructor's receiver is QUALIFIED — 'Inner(Outer Outer.this)' —
# so the type is followed by an optional qualifying name before 'this'.
#
# The ordinary form spells '...' and C-style Dims as ALTERNATIVES, not an optional
# pair: JLS 8.4.1 forbids combining them, so 'int... x[]' is illegal. The '...' may
# itself carry type annotations ('int @Ann ... x').
Param <- Annotation* Type (QualifiedName '.')? < 'this' ![a-zA-Z0-9_$] > / Annotation* Modifier* Type (Annotation* '...' Identifier / Identifier Dims?)
Throws <- 'throws' ^ TypeList
ConstructorDecl <- Annotation* TypeParams? Identifier '(' ^ Params? ')' Throws? Block

# === Blocks and Statements (JLS 14) ===
Block <- '{' BlockStmt* '}'
BlockStmt <- LocalVar / LocalTypeDecl / Stmt
LocalTypeDecl <- Annotation* (Modifier / ValueKW &(Modifier* (ClassKW / RecordKW)))* TypeKind
LocalVar <- Annotation* Modifier* LocalVarType VarDecls ';'
LocalVarType <- < 'var' ![a-zA-Z0-9_$] > / Type
# Statement keywords use helper rules to combine keyword + word boundary as single token
# This prevents the parser from skipping whitespace before the boundary check
# Cut operator after literal keywords commits to that statement type
# NOTE: Cuts must NOT be placed after token boundary rules (< ... >) like *KW rules
#       as this breaks trivia handling and causes missing spaces after keywords
Stmt <- Block
     / IfKW ^ '(' Expr ')' Stmt ('else' Stmt)?
     / WhileKW ^ '(' Expr ')' Stmt
     / ForKW ^ '(' ForCtrl ')' Stmt
     / DoKW ^ Stmt 'while' '(' Expr ')' ';'
     / TryKW ^ ResourceSpec? Block Catch* Finally?
     / SwitchKW ^ '(' Expr ')' SwitchBlock
     / ReturnKW Expr? ';'
     / ThrowKW Expr ';'
     / BreakKW Identifier? ';'
     / ContinueKW Identifier? ';'
     / AssertKW Expr (':' Expr)? ';'
     / SynchronizedKW ^ '(' Expr ')' Block
     / YieldKW Expr ';'
     / Identifier ':' Stmt
     / Expr ';'
     / ';'

# Helper rules: keyword with word boundary INSIDE token (prevents whitespace skip before boundary check)
IfKW <- < 'if' ![a-zA-Z0-9_$] >
WhileKW <- < 'while' ![a-zA-Z0-9_$] >
ForKW <- < 'for' ![a-zA-Z0-9_$] >
DoKW <- < 'do' ![a-zA-Z0-9_$] >
TryKW <- < 'try' ![a-zA-Z0-9_$] >
SwitchKW <- < 'switch' ![a-zA-Z0-9_$] >
SynchronizedKW <- < 'synchronized' ![a-zA-Z0-9_$] >
ReturnKW <- < 'return' ![a-zA-Z0-9_$] >
ThrowKW <- < 'throw' ![a-zA-Z0-9_$] >
BreakKW <- < 'break' ![a-zA-Z0-9_$] >
ContinueKW <- < 'continue' ![a-zA-Z0-9_$] >
AssertKW <- < 'assert' ![a-zA-Z0-9_$] >
YieldKW <- < 'yield' ![a-zA-Z0-9_$] >
CatchKW <- < 'catch' ![a-zA-Z0-9_$] >
FinallyKW <- < 'finally' ![a-zA-Z0-9_$] >
WhenKW <- < 'when' ![a-zA-Z0-9_$] >
ForCtrl <- ForInit? ';' Expr? ';' ExprList? / Annotation* Modifier* LocalVarType Identifier ':' Expr
ForInit <- LocalVarNoSemi / ExprList
LocalVarNoSemi <- Annotation* Modifier* LocalVarType VarDecls
ResourceSpec <- '(' Resource (';' Resource)* ';'? ')'
Resource <- Annotation* Modifier* LocalVarType Identifier '=' Expr / QualifiedName
Catch <- CatchKW ^ '(' Modifier* Type ('|' Type)* Identifier ')' Block
Finally <- FinallyKW ^ Block
SwitchBlock <- '{' SwitchRule* '}'
SwitchRule <- SwitchLabel '->' (Expr ';' / Block / ThrowKW Expr ';') / SwitchLabel ':' BlockStmt*
# === Switch Labels and Patterns (JLS 14.11, 14.30) ===
SwitchLabel <- 'case' ^ ('null' ',' 'default' / CaseItem (',' CaseItem)* Guard?) / 'default'
CaseItem <- Pattern / QualifiedName &('->' / ',' / ':' / 'when') / Expr
Pattern <- RecordPattern / TypePattern
TypePattern <- &(Annotation* Modifier* LocalVarType Identifier) Annotation* Modifier* LocalVarType Identifier / '_'
RecordPattern <- RefType '(' PatternList? ')'
PatternList <- Pattern (',' Pattern)*
# A guard is a boolean expression, never a lambda (JLS 14.11.1). Going through Expr would
# try the Lambda alternative first and swallow the switch rule's arrow on a bare-identifier
# guard: 'case Integer i when b -> {}' parsed 'b -> {}' as the guard. Assignment is Expr
# minus the top-level Lambda alternative.
Guard <- WhenKW Assignment

Expr <- Lambda / Assignment
Assignment <- Ternary ((URShiftAssign / RShiftAssign / LShiftAssign / '=' / '+=' / '-=' / '*=' / '/=' / '%=' / '&=' / '|=' / '^=') Expr)?
Ternary <- LogOr ('?' Expr ':' (Lambda / Ternary))?
LogOr <- LogAnd ('||' LogAnd)*
LogAnd <- BitOr ('&&' BitOr)*
BitOr <- BitXor (!'||' !'|=' '|' BitXor)*
BitXor <- BitAnd (!'^=' '^' BitAnd)*
BitAnd <- Equality (!'&&' !'&=' '&' Equality)*
Equality <- Relational (('==' / '!=') Relational)*
Relational <- Shift (('<=' / '>=' / '<' / '>') Shift / 'instanceof' (Pattern / Type))?
Shift <- Additive ((URShift / LShift / RShift) Additive)*
# Shift / shift-assignment helpers (split into single '<' / '>' / '=' tokens so that
# the lexer never produces a fused '>>' token. This lets nested generics like
# List<Map<String, Integer>> parse correctly while still recognising shift ops.)
URShift <- '>' '>' '>' !'='
RShift <- '>' '>' !'>' !'='
LShift <- '<' '<' !'='
URShiftAssign <- '>' '>' '>' '='
RShiftAssign <- '>' '>' '='
LShiftAssign <- '<' '<' '='
Additive <- Multiplicative ((!'+=' '+' / !'-=' !'->' '-') Multiplicative)*
Multiplicative <- Unary ((!'*=' '*' / !'/=' '/' / !'%=' '%') Unary)*
Unary <- ('++' / '--' / '+' / '-' / '!' / '~') Unary / '(' Type ('&' Type)* ')' (Lambda / Unary) / Postfix
Postfix <- Primary PostOp*
PostOp <- '.' 'new' TypeArgs? ArrayType ('(' Args? ')') ClassBody? / '.' TypeArgs? Identifier ('(' Args? ')')? / '.' 'class' / '.' 'this' / '.' < 'super' ![a-zA-Z0-9_$] > / '[' Expr ']' / '(' Args? ')' / '++' / '--' / '::' TypeArgs? (Identifier / 'new')
Primary <- Literal / TypeArgs (< 'this' ![a-zA-Z0-9_$] > / < 'super' ![a-zA-Z0-9_$] >) '(' Args? ')' / < 'this' ![a-zA-Z0-9_$] > / < 'super' ![a-zA-Z0-9_$] > / < 'new' ![a-zA-Z0-9_$] > TypeArgs? ArrayType (DimExprs Dims? / Dims VarInit / '(' Args? ')' ClassBody?) / SwitchKW '(' Expr ')' SwitchBlock / '(' Expr ')' / TypeExpr / QualifiedName
TypeExpr <- Type ('.' < 'class' > / '::' TypeArgs? (< 'new' > / Identifier))
Lambda <- LambdaParams '->' (Expr / Block)
LambdaParams <- Identifier / '_' / '(' LambdaParam? (',' LambdaParam)* ')'
LambdaParam <- Annotation* Modifier* ((< 'var' ![a-zA-Z0-9_$] > / Type) &('...' / Identifier / '_'))? '...'? (Identifier / '_')
Args <- Expr (',' Expr)*
ExprList <- Expr (',' Expr)*

# === Types with Type-Use Annotations (JSR 308 / JLS 4.11) ===
Type <- Annotation* (PrimType / RefType) Dims?
PrimType <- < ('boolean' / 'byte' / 'short' / 'int' / 'long' / 'float' / 'double' / 'char' / 'void') ![a-zA-Z0-9_$] >
# Use lookahead BEFORE consuming '.' to avoid capturing it when followed by keyword (e.g., 'HashMap.class')
RefType <- AnnotatedTypeName (&('.' ('@' / Identifier)) '.' AnnotatedTypeName)*
# JLS 3.9: 'var' and 'yield' are RESTRICTED type names — legal as ordinary identifiers
# ('int var = 3;', 'obj.yield()') but never as the name of a type in type-use position.
# Identifier deliberately excludes only HARD keywords, so without this guard a
# contextual keyword slips through as a type name. LocalVarType keeps its own explicit
# 'var' alternative, so local type inference is unaffected.
AnnotatedTypeName <- Annotation* !RestrictedTypeName Identifier TypeArgs?
RestrictedTypeName <- < ('var' / 'yield') ![a-zA-Z0-9_$] >
Dims <- (Annotation* '[' ']')+
# ArrayType is Type without trailing Dims - used for array creation expressions
ArrayType <- Annotation* (PrimType / RefType)
# DimExprs are dimension expressions with sizes - e.g., [10], [rows][cols]
# Lookahead BEFORE consuming '[' prevents java-peglib bug where failed iterations leave partial matches
DimExprs <- (Annotation* &('[' !']') '[' Expr ']')+
TypeArgs <- '<' '>' / '<' TypeArg (',' TypeArg)* '>'
TypeArg <- Type / Annotation* '?' (Annotation* ('extends' / 'super') Type)?

# Use lookahead BEFORE consuming '.' to avoid capturing it when followed by keyword (e.g., 'String.class')
QualifiedName <- Identifier (&('.' Identifier) '.' Identifier)*
Identifier <- !Keyword < [a-zA-Z_$] [a-zA-Z0-9_$]* >

Modifier <- < ('public' / 'protected' / 'private' / 'static' / 'final' / 'abstract' / 'native' / 'synchronized' / 'transient' / 'volatile' / 'strictfp' / 'default' / 'sealed' / 'non-sealed') ![a-zA-Z0-9_$] >
# JEP 401 (Value Objects, preview in JDK 28) — 'value' is a contextual keyword.
# It is a modifier ONLY in type-declaration position; everywhere else it must stay
# an ordinary identifier ('var value = 3', 'int value;', 'value.foo()'), and it is
# by far the most common identifier of any contextual keyword Java has added.
#
# Two deliberate choices keep that safe:
#   1. The '(Modifier / ValueKW &(Modifier* (ClassKW / RecordKW)))*' group is spelled inline at exactly the four
#      sites where a TypeKind can follow — TypeDecl, ClassMember, LocalTypeDecl,
#      AnnotationMember. LocalVar / Param / Catch / Resource / LambdaParam keep
#      plain Modifier*, so statement contexts never try the 'value' alternative.
#      (A named DeclModifier rule cannot be used here: RuleClassifier types it as
#      LEXER, and a lexer rule may not reference another rule — fromGrammar rejects
#      it with SkippedRuleReferenced.)
#   2. The lookahead references Modifier only, so 'value' cannot recurse into
#      itself. It commits only when a class/record keyword genuinely follows,
#      across any intervening modifiers ('sealed abstract value class X').
ValueKW <- < 'value' ![a-zA-Z0-9_$] >
Annotation <- '@' !'interface' QualifiedName ('(' AnnotationValue? ')')?
AnnotationValue <- Identifier '=' AnnotationElem (',' Identifier '=' AnnotationElem)* / AnnotationElem (',' AnnotationElem)*
# A lambda may appear as an annotation value: '@Anno(value = x -> x)'. javac's parser
# accepts it and rejects it in Attr. Lambda used to be reachable here via Primary.
AnnotationElem <- Annotation / '{' (AnnotationElem (',' AnnotationElem)*)? ','? '}' / Lambda / Ternary

Literal <- < ('null' / 'true' / 'false') ![a-zA-Z0-9_$] > / CharLit / StringLit / NumLit
# JLS 3.10.6: the escape set is closed — b, s, t, n, f, r, ", ', backslash, an octal
# escape, or a \\u sequence. '\\' . accepted anything, so '\\e' and '\\q' slipped through.
# A char literal holds EXACTLY one element: '' is empty, and a raw newline may not appear
# inside either a char or a (non-text-block) string literal.
CharLit <- < '\'' ([^'\\\n\r] / '\\' ([btnfrs"'\\] / [0-3] [0-7] [0-7] / [0-7] [0-7]? / 'u'+ [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F])) '\'' >
StringLit <- < '"""' (!'"""' .)* '"""' >
           / < '"' ([^"\\\n\r] / '\\' ([btnfrs"'\\] / [0-3] [0-7] [0-7] / [0-7] [0-7]? / 'u'+ [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F]))* '"' >
# JLS 3.10.1: an underscore may appear only BETWEEN digits — never leading, never
# trailing, never adjacent to '.', 'x', 'b', or a type suffix. Each digit run is
# therefore spelled 'digit (digit-or-underscore* digit)?', which permits '1__0' (runs
# of underscores are legal) while rejecting '1_', '0x_1' and '1_.5'. The runs are
# written inline rather than factored into a Digits rule: a lexer rule may not
# reference another rule, and fromGrammar rejects it with SkippedRuleReferenced.
NumLit <- < '0' [xX] [0-9a-fA-F] ([0-9a-fA-F_]* [0-9a-fA-F])? ('.' ([0-9a-fA-F] ([0-9a-fA-F_]* [0-9a-fA-F])?)?)? [pP] [+\-]? [0-9] ([0-9_]* [0-9])? [fFdD]? >
        / < '0' [xX] '.' [0-9a-fA-F] ([0-9a-fA-F_]* [0-9a-fA-F])? [pP] [+\-]? [0-9] ([0-9_]* [0-9])? [fFdD]? >
        / < '0' [xX] [0-9a-fA-F] ([0-9a-fA-F_]* [0-9a-fA-F])? [lL]? >
        / < '0' [bB] [01] ([01_]* [01])? [lL]? >
        / < [0-9] ([0-9_]* [0-9])? ('.' ([0-9] ([0-9_]* [0-9])?)?)? ([eE] [+\-]? [0-9] ([0-9_]* [0-9])?)? [fFdDlL]? >
        / < '.' [0-9] ([0-9_]* [0-9])? ([eE] [+\-]? [0-9] ([0-9_]* [0-9])?)? [fFdD]? >

# Hard keywords only - contextual keywords (var, yield, record, sealed, non-sealed, permits, when, module) are handled by their specific rules
Keyword <- ('abstract' / 'assert' / 'boolean' / 'break' / 'byte' / 'case' / 'catch' / 'char' / 'class' / 'const' / 'continue' / 'default' / 'double' / 'do' / 'else' / 'enum' / 'extends' / 'false' / 'finally' / 'final' / 'float' / 'for' / 'goto' / 'implements' / 'import' / 'instanceof' / 'interface' / 'int' / 'if' / 'long' / 'native' / 'new' / 'null' / 'package' / 'private' / 'protected' / 'public' / 'return' / 'short' / 'static' / 'strictfp' / 'super' / 'switch' / 'synchronized' / 'this' / 'throws' / 'throw' / 'transient' / 'true' / 'try' / 'void' / 'volatile' / 'while') ![a-zA-Z0-9_$]

# 0.6.2 — the unsplit folded form is supported again: DfaBuilder.absorbWhitespace
# absorbs each Choice alternative at its own trivia kind (WHITESPACE / LINE_COMMENT
# / DOC_LINE_COMMENT / BLOCK_COMMENT / DOC_BLOCK_COMMENT), so the lexer's maximal-
# munch loop emits one correctly-classified token per trivia chunk. The whitespace
# alternative is absorbed as one-or-more, so the DFA start state never accepts the
# empty string (no empty-match warning).
%whitespace <- ([ \t\r\n] / '//' [^\n]* / '/*' (!'*/' .)* '*/')*

# 0.6.1 — incremental-reparse boundaries consumed by IncrementalParser.
# Each %checkpoint names a rule whose CST subtree may be re-parsed in
# isolation when an edit lies entirely within its byte span.
%checkpoint Stmt
%checkpoint MethodDecl
%checkpoint TypeDecl
